# Copie este arquivo para ".env" (ou apenas exporte a variavel no terminal) para
# habilitar o refinamento do plano de treino com IA generativa (Claude).
# Sem esta chave configurada, o app funciona normalmente usando o motor de
# sugestao por heuristica (baseado nos dados reais de avaliacoes/jogos/video).
ANTHROPIC_API_KEY=

# Porta em que o servidor sobe (opcional, padrao 3000)
PORT=3000
